{
  "name": "Solar System Monitoring & AI Agent Workspace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "b-asaf/ai-framework": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "christian-kohler.path-intellisense"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-ai-framework.sh",
  "remoteUser": "node"
}